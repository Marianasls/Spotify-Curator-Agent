# PROVIDER GEMINI API
GEMINI_API_KEY=
# sem o prefixo "gemini/"
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_FREE_USES=5


# SPOTIFY API
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI="http://127.0.0.1:8501/callback"

# Langfuse / Tracing (Opcional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"


ENVIRONMENT=development

# Banco de Dados (Opcional - usa MemorySaver se omitido)
# DATABASE_URL=postgresql://user:pass@host:5432/langchain_db